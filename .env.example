# Backend API
# URL of the Express backend (see /server). Defaults to
# http://localhost:5000/api if not set.
VITE_API_URL=http://localhost:5000/api

# Firebase Configuration
# Instructions:
# 1. Create a Firebase project at https://console.firebase.google.com and add a Web App.
# 2. In Authentication > Sign-in method, enable Google.
# 3. In Authentication > Settings > Authorized domains, add localhost for development
#    and the exact hostname used to publish this app.
# 4. Copy the Web App config values below, save this as .env.local, and restart Vite.
# 5. DO NOT commit .env.local to version control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

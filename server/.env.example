# Server
PORT=5000
NODE_ENV=development

# Local demo convenience only: first login with an email ending in .admin,
# .staff, or .customer creates that role account using the entered password.
# This auto-provisioning is disabled whenever NODE_ENV=production.
EMAIL_ROLE_DEMO_MODE=true

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/greenleaf_nursery

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - the URL the Vite dev server runs on
CLIENT_URL=http://localhost:5173
